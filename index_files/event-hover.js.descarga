const hoverPreview=document.createElement('div');hoverPreview.className='event-hover';hoverPreview.hidden=true;hoverPreview.setAttribute('aria-hidden','true');const hoverImage=document.createElement('img');hoverImage.alt='';hoverPreview.append(hoverImage);document.body.append(hoverPreview);function hidePreview(){hoverPreview.hidden=true}document.querySelectorAll('.event-thumb').forEach(button=>{function show(){if(!matchMedia('(hover:hover) and (pointer:fine)').matches||document.querySelector('dialog[open]'))return;const img=button.querySelector('img'),r=button.getBoundingClientRect();hoverImage.src=img.src;hoverPreview.hidden=false;const w=252,h=312;hoverPreview.style.left=Math.max(8,Math.min(innerWidth-w-8,r.left+r.width/2-w/2))+'px';hoverPreview.style.top=Math.max(8,r.top-h-12>=8?r.top-h-12:Math.min(innerHeight-h-8,r.bottom+12))+'px'}button.addEventListener('mouseenter',show);button.addEventListener('focus',show);button.addEventListener('mouseleave',hidePreview);button.addEventListener('blur',hidePreview);button.addEventListener('click',hidePreview)});addEventListener('scroll',hidePreview,true);addEventListener('resize',hidePreview);document.addEventListener('keydown',e=>{if(e.key==='Escape')hidePreview()});
