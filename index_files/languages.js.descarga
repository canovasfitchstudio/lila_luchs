const translations={"Zum Inhalt": {"en": "Skip to content", "fr": "Aller au contenu"}, "Kaffee, Brunch & kleine Auszeiten ·": {"en": "Coffee, brunch & little breaks ·", "fr": "Café, brunch et petites pauses ·"}, "Zofingen Altstadt": {"en": "Zofingen Old Town", "fr": "Vieille ville de Zofingen"}, "Menü ☰": {"en": "Menu ☰", "fr": "Menu ☰"}, "Speisekarte": {"en": "Menu", "fr": "La carte"}, "Für Familien": {"en": "For families", "fr": "En famille"}, "Über uns": {"en": "About us", "fr": "À propos"}, "Momente": {"en": "Moments", "fr": "Moments"}, "Events": {"en": "Events", "fr": "Événements"}, "Besuch uns": {"en": "Visit us", "fr": "Nous rendre visite"}, "Tisch reservieren": {"en": "Request a table", "fr": "Demander une table"}, "Dein Lieblingsplatz in der Altstadt": {"en": "Your favourite spot in the Old Town", "fr": "Votre adresse préférée dans la vieille ville"}, "Deine kleine": {"en": "Your little", "fr": "Votre petite"}, "Auszeit": {"en": "escape", "fr": "pause"}, "in Zofingen.": {"en": "in Zofingen.", "fr": "à Zofingen."}, "Kaffee, Bagels & Brunch – und ein gemütliches Spielzimmer für die Kleinen. Komm vorbei und fühl dich wie zuhause.": {"en": "Coffee, bagels & brunch – with a cosy playroom for the little ones. Come in and make yourself at home.", "fr": "Café, bagels et brunch – avec une salle de jeux pour les petits. Venez vous sentir comme chez vous."}, "Speisekarte entdecken": {"en": "Explore the menu", "fr": "Découvrir la carte"}, "Öffnungszeiten & Anreise": {"en": "Opening hours & directions", "fr": "Horaires et accès"}, "Kaffee. Kinder. Lieblingsmomente.": {"en": "Coffee. Kids. Happy moments.", "fr": "Café. Enfants. Jolis moments."}, "Mit Liebe in Zofingen": {"en": "With love in Zofingen", "fr": "Avec amour à Zofingen"}, "Kaffee mit Herz": {"en": "Coffee with heart", "fr": "Du café préparé avec cœur"}, "Sonntagsfrühstück": {"en": "Sunday breakfast", "fr": "Petit-déjeuner du dimanche"}, "Kinder willkommen": {"en": "Children welcome", "fr": "Enfants bienvenus"}, "Unsere Lieblingsmomente": {"en": "Our favourite moments", "fr": "Nos moments préférés"}, "Eine Pause,": {"en": "A break,", "fr": "Une pause,"}, "ganz nach deinem Geschmack.": {"en": "just the way you like it.", "fr": "à votre goût."}, "Etwas Warmes in der Tasse, etwas Feines auf dem Teller. Entdecke unser Angebot für deine nächste Auszeit.": {"en": "Something warm in your cup, something delicious on your plate. Find your next little treat.", "fr": "Une boisson chaude, une gourmandise dans l’assiette. Découvrez nos plaisirs pour votre prochaine pause."}, "Matcha & mehr": {"en": "Matcha & more", "fr": "Matcha et plus encore"}, "Grüne Lieblingsmomente und etwas Feines dazu.": {"en": "A little matcha moment with something delicious.", "fr": "Une pause matcha accompagnée d’une gourmandise."}, "Bagels mit Liebe": {"en": "Bagels made with love", "fr": "Des bagels préparés avec amour"}, "Für den kleinen und grossen Hunger.": {"en": "For appetites big and small.", "fr": "Pour les petites et les grandes faims."}, "Bunte Bowls": {"en": "Colourful bowls", "fr": "Des bowls colorés"}, "Ein bisschen Farbe auf deinem Tisch.": {"en": "A little colour on your table.", "fr": "Un peu de couleur à votre table."}, "Süsse Pausen": {"en": "Sweet breaks", "fr": "Pauses gourmandes"}, "Zeit für Kaffee und etwas Feines.": {"en": "Time for coffee and a treat.", "fr": "Le moment d’un café et d’une gourmandise."}, "Vollständiges Menü & Preise": {"en": "Full menu & prices", "fr": "Carte complète et prix"}, "Kleine Gäste. Grosses Willkommen.": {"en": "Little guests. A big welcome.", "fr": "Petits invités. Grand accueil."}, "Ein Café für dich.": {"en": "A café for you.", "fr": "Un café pour vous."}, "Und deine Kleinen.": {"en": "And your little ones.", "fr": "Et vos petits."}, "Ein Ort, an dem sich die ganze Familie wohlfühlen darf. Mit einem Spielzimmer für die Kinder und Lieblingsmomenten für die Grossen.": {"en": "A place for the whole family to feel at home. A playroom for the children and lovely moments for the grown-ups.", "fr": "Un lieu où toute la famille se sent bien. Une salle de jeux pour les enfants et de jolis moments pour les grands."}, "Ein gemütliches Spielzimmer": {"en": "A cosy playroom", "fr": "Une salle de jeux accueillante"}, "Frühstück, Snacks und gemeinsame Pausen": {"en": "Breakfast, snacks and time together", "fr": "Petit-déjeuner, snacks et pauses ensemble"}, "Eine herzliche Atmosphäre für alle": {"en": "A warm atmosphere for everyone", "fr": "Une ambiance chaleureuse pour tous"}, "Eure Familienpause planen": {"en": "Plan your family visit", "fr": "Préparer votre visite en famille"}, "Die Menschen hinter Lila Luchs": {"en": "The people behind Lila Luchs", "fr": "Les personnes derrière Lila Luchs"}, "Guter Kaffee.": {"en": "Good coffee.", "fr": "Un bon café."}, "Noch bessere Gesellschaft.": {"en": "Even better company.", "fr": "Une compagnie encore meilleure."}, "Ein Café lebt von den Menschen, die es mit Leben füllen. Von der ersten Tasse am Morgen bis zum gemütlichen Gespräch am Nachmittag: Wir freuen uns, dich bei uns willkommen zu heissen.": {"en": "People bring a café to life. From your first morning cup to a relaxed afternoon conversation, we look forward to welcoming you.", "fr": "Ce sont les gens qui font vivre un café. De la première tasse du matin aux conversations de l’après-midi, nous sommes heureux de vous accueillir."}, "Mitten in der Altstadt von Zofingen ist Lila Luchs ein Platz für kleine Pausen, gemeinsame Zeit und ein herzliches Miteinander.": {"en": "In the heart of Zofingen’s Old Town, Lila Luchs is a place for little breaks, shared moments and a warm welcome.", "fr": "Au cœur de la vieille ville de Zofingen, Lila Luchs est un lieu de pauses, de partage et de convivialité."}, "Bis bald im Lila Luchs ♡": {"en": "See you soon at Lila Luchs ♡", "fr": "À bientôt chez Lila Luchs ♡"}, "Einblicke auf Instagram": {"en": "Follow our moments on Instagram", "fr": "Nos moments sur Instagram"}, "Ein kleiner Blick in unseren Alltag": {"en": "A glimpse of everyday life", "fr": "Un aperçu de notre quotidien"}, "Ein Kaffee am Fenster, eine süsse Pause oder Zeit zusammen. Finde deinen Lieblingsmoment.": {"en": "Coffee by the window, a sweet break or time together. Find your favourite moment.", "fr": "Un café à la fenêtre, une pause sucrée ou un moment ensemble. Trouvez votre instant préféré."}, "Alle": {"en": "All", "fr": "Tout"}, "Genuss": {"en": "Food & drinks", "fr": "Gourmandises"}, "Unser Café": {"en": "Our café", "fr": "Notre café"}, "Ein sonniger Platz": {"en": "A sunny spot", "fr": "Un coin ensoleillé"}, "Frisch gebrühter Espresso": {"en": "Freshly brewed espresso", "fr": "Un espresso fraîchement préparé"}, "Kleine süsse Lieblinge": {"en": "Little sweet favourites", "fr": "Petites douceurs préférées"}, "Ein Blick ins Café": {"en": "A look inside", "fr": "Un aperçu du café"}, "Iced Coffee, bitte": {"en": "Iced coffee, please", "fr": "Un café glacé, s’il vous plaît"}, "Willkommen an unserer Theke": {"en": "Welcome to our counter", "fr": "Bienvenue au comptoir"}, "Eine süsse Pause": {"en": "A sweet break", "fr": "Une pause sucrée"}, "Der Platz am Fenster": {"en": "The window seat", "fr": "La place près de la fenêtre"}, "Etwas Feines aus der Vitrine": {"en": "A treat from the counter", "fr": "Une gourmandise de la vitrine"}, "Zeit für dich": {"en": "Time for yourself", "fr": "Du temps pour vous"}, "Kuchen & Chinotto": {"en": "Cake & Chinotto", "fr": "Gâteau et Chinotto"}, "Ein Moment auf Eis": {"en": "A moment on ice", "fr": "Un instant glacé"}, "Espresso & Croissant": {"en": "Espresso & croissant", "fr": "Espresso et croissant"}, "Ein kleiner Kaffeemoment": {"en": "A little coffee moment", "fr": "Un petit moment café"}, "Croissant & Kaffee": {"en": "Croissant & coffee", "fr": "Croissant et café"}, "Zusammen geniessen": {"en": "Enjoying time together", "fr": "Savourer ensemble"}, "Eine Pause im Grünen": {"en": "A break in the greenery", "fr": "Une pause au vert"}, "Zum Anstossen": {"en": "Cheers to that", "fr": "Pour trinquer"}, "Mehr als Kaffee": {"en": "More than coffee", "fr": "Bien plus qu’un café"}, "Kleine Events.": {"en": "Small events.", "fr": "Petits événements."}, "Grosse Erinnerungen.": {"en": "Big memories.", "fr": "Grands souvenirs."}, "Musik, Bewegung und Genuss: besondere Momente, schöne Erinnerungen und Zeit zusammen bei Lila Luchs.": {"en": "Music, movement and good food: special moments, lovely memories and time together at Lila Luchs.", "fr": "Musique, mouvement et gourmandise : des moments privilégiés et de beaux souvenirs chez Lila Luchs."}, "Genussmomente · Auf Anfrage": {"en": "Special treats · On request", "fr": "Instants gourmands · Sur demande"}, "Austern, Champagner und Zeit zum Geniessen. Frag uns nach kommenden Terminen oder einem Oyster-Catering für deinen Anlass.": {"en": "Oysters, champagne and time to enjoy them. Ask about upcoming dates or oyster catering for your occasion.", "fr": "Huîtres, champagne et moments à savourer. Contactez-nous pour les prochaines dates ou un service traiteur d’huîtres pour votre événement."}, "Termin anfragen": {"en": "Enquire about a date", "fr": "Demander une date"}, "Wir freuen uns auf deine Nachricht.": {"en": "We look forward to hearing from you.", "fr": "Nous attendons votre message avec plaisir."}, "Rückblick · Im Café": {"en": "Past event · At the café", "fr": "Souvenir · Au café"}, "Baby Konzert": {"en": "Baby concert", "fr": "Concert pour les tout-petits"}, "Klavier und Violine zu Besuch im Lila Luchs: Unsere kleinsten Gäste konnten Musik live erleben, mitsingen und tanzen. Ein fröhlicher Moment für die ganze Familie.": {"en": "Piano and violin came to Lila Luchs: our youngest guests enjoyed live music, singing and dancing. A joyful moment for the whole family.", "fr": "Piano et violon se sont invités chez Lila Luchs : nos plus petits invités ont pu écouter, chanter et danser. Un joyeux moment en famille."}, "Rückblick · Rosengarten & Café": {"en": "Past event · Rose garden & café", "fr": "Souvenir · Roseraie et café"}, "Yoga im Rosengarten Zofingen, eine Klangmeditation unter freiem Himmel und danach ein gemeinsamer Brunch im Café. Eine Auszeit zum Durchatmen und Geniessen.": {"en": "Yoga in Zofingen’s rose garden, an outdoor sound meditation and brunch together at the café. A break to breathe and enjoy.", "fr": "Yoga dans la roseraie de Zofingen, méditation sonore en plein air, puis brunch au café. Une pause pour respirer et savourer."}, "Für Baby Konzert und Yoga + Brunch sind noch keine neuen Termine angekündigt. Neuigkeiten und Anmeldelinks teilen wir auf Instagram. Termine für Oysters & Champagne kannst du direkt bei uns anfragen.": {"en": "No new dates have been announced for the baby concert or Yoga + Brunch. News and booking links are shared on Instagram. Contact us directly about Oysters & Champagne dates.", "fr": "Aucune nouvelle date n’est annoncée pour le concert des tout-petits ou Yoga + Brunch. Actualités et inscriptions sur Instagram. Contactez-nous pour Oysters & Champagne."}, "Lila Luchs auf Instagram": {"en": "Lila Luchs on Instagram", "fr": "Lila Luchs sur Instagram"}, "Lieblingsplätze werden geteilt": {"en": "Favourite places are shared", "fr": "Les bonnes adresses se partagent"}, "Was unsere Gäste erzählen.": {"en": "What our guests say.", "fr": "Ce qu’en disent nos clients."}, "Lerne Lila Luchs durch die Erfahrungen unserer Gäste kennen.": {"en": "Discover Lila Luchs through our guests’ experiences.", "fr": "Découvrez Lila Luchs à travers les expériences de nos clients."}, "Bewertungen auf Google ansehen": {"en": "Read reviews on Google", "fr": "Lire les avis sur Google"}, "Wir freuen uns auf dich": {"en": "We look forward to seeing you", "fr": "Au plaisir de vous accueillir"}, "Mitten in Zofingen.": {"en": "In the heart of Zofingen.", "fr": "Au cœur de Zofingen."}, "Einfach vorbeikommen.": {"en": "Just drop by.", "fr": "Venez nous voir."}, "4800 Zofingen, Schweiz": {"en": "4800 Zofingen, Switzerland", "fr": "4800 Zofingen, Suisse"}, "Dienstag–Samstag": {"en": "Tuesday–Saturday", "fr": "Mardi–samedi"}, "Sonntag": {"en": "Sunday", "fr": "Dimanche"}, "Montag": {"en": "Monday", "fr": "Lundi"}, "Geschlossen": {"en": "Closed", "fr": "Fermé"}, "Online kannst du bis am Vortag reservieren. Für einen Tisch am selben Tag ruf uns bitte an.": {"en": "Please request a table at least a day ahead. For a table today, please call us.", "fr": "Merci de demander votre table au moins la veille. Pour le jour même, appelez-nous."}, "Route öffnen": {"en": "Get directions", "fr": "Itinéraire"}, "Vor deinem Besuch": {"en": "Before your visit", "fr": "Avant votre visite"}, "Noch eine Frage?": {"en": "Any questions?", "fr": "Une question ?"}, "Kann ich einen Tisch reservieren?": {"en": "Can I book a table?", "fr": "Puis-je réserver une table ?"}, "Ja. Online-Reservationen sind bis am Vortag möglich. Für Reservationen am selben Tag erreichst du uns unter": {"en": "Yes. Please request your table at least a day ahead. For same-day reservations call", "fr": "Oui. Faites votre demande au moins la veille. Pour une réservation le jour même, appelez le"}, "Sind Kinder willkommen?": {"en": "Are children welcome?", "fr": "Les enfants sont-ils bienvenus ?"}, "Ja! Lila Luchs ist ein Familiencafé mit einem Spielzimmer für unsere kleinen Gäste.": {"en": "Yes! Lila Luchs is a family café with a playroom for our little guests.", "fr": "Oui ! Lila Luchs est un café familial avec une salle de jeux pour nos petits invités."}, "Wo finde ich die aktuelle Speisekarte?": {"en": "Where can I find the menu?", "fr": "Où trouver la carte ?"}, "Unsere vollständige Karte findest du": {"en": "You can find our full menu", "fr": "Vous trouverez notre carte complète"}, "hier": {"en": "here", "fr": "ici"}, ". Bei Allergien oder besonderen Ernährungswünschen sprich bitte vor der Bestellung mit unserem Team.": {"en": ". Please discuss allergies or dietary requirements with our team before ordering.", "fr": ". En cas d’allergies ou de besoins alimentaires particuliers, parlez-en à notre équipe avant de commander."}, "Anrufen": {"en": "Call us", "fr": "Appeler"}, "Schliessen ×": {"en": "Close ×", "fr": "Fermer ×"}, "Deine Anfrage": {"en": "Your enquiry", "fr": "Votre demande"}, "Schreib uns zu Oysters & Champagne, einem Catering oder deinem nächsten Besuch.": {"en": "Ask us about Oysters & Champagne, catering or your next visit.", "fr": "Écrivez-nous pour Oysters & Champagne, un service traiteur ou votre prochaine visite."}, "Vorname": {"en": "First name", "fr": "Prénom"}, "Nachname": {"en": "Last name", "fr": "Nom"}, "E-Mail": {"en": "Email", "fr": "E-mail"}, "Nachricht": {"en": "Message", "fr": "Message"}, "Der nächste Schritt öffnet deine E-Mail-App mit dem ausgefüllten Text. Dort sendest du die Nachricht an info@lila-luchs.ch.": {"en": "The next step opens your email app with your completed message. Send it there to info@lila-luchs.ch.", "fr": "L’étape suivante ouvre votre application e-mail avec le message rempli. Envoyez-le ensuite à info@lila-luchs.ch."}, "E-Mail zum Senden öffnen": {"en": "Open email to send", "fr": "Ouvrir l’e-mail pour envoyer"}, "Direkt an info@lila-luchs.ch schreiben": {"en": "Write directly to info@lila-luchs.ch", "fr": "Écrire directement à info@lila-luchs.ch"}, "Blumen auf dem Tisch": {"en": "Flowers on the table", "fr": "Des fleurs à table"}, "Süsse Genussmomente": {"en": "Sweet treats", "fr": "Instants gourmands"}, "Früchte & Granola": {"en": "Fruit & granola", "fr": "Fruits et granola"}, "Kaffee-Spezialitäten": {"en": "Coffee specialities", "fr": "Spécialités de café"}, "Frühstück im Glas": {"en": "Breakfast in a glass", "fr": "Petit-déjeuner en verrine"}, "Unsere Farben": {"en": "Our colours", "fr": "Nos couleurs"}, "Frischer Genuss": {"en": "Fresh flavours", "fr": "Saveurs fraîches"}, "Hummus & Kichererbsen": {"en": "Hummus & chickpeas", "fr": "Houmous et pois chiches"}, "Eine warme Pause": {"en": "A warming break", "fr": "Une pause réconfortante"}, "Suppe & Brot": {"en": "Soup & bread", "fr": "Soupe et pain"}, "Frisch belegter Bagel": {"en": "Freshly filled bagel", "fr": "Bagel fraîchement garni"}, "Bagel-Moment": {"en": "A bagel moment", "fr": "Un moment bagel"}, "Unsere Bagels": {"en": "Our bagels", "fr": "Nos bagels"}, "Apéro-Zeit": {"en": "Aperitif time", "fr": "L’heure de l’apéro"}, "Ein gemütlicher Winkel": {"en": "A cosy corner", "fr": "Un coin douillet"}};
const languageSelect=document.getElementById('site-language');let activeLanguage='de';const originalNodes=[];const walker=document.createTreeWalker(document.body,NodeFilter.SHOW_TEXT,{acceptNode:n=>n.parentElement.closest('script,style,select,.placeholder')?NodeFilter.FILTER_REJECT:NodeFilter.FILTER_ACCEPT});while(walker.nextNode()){const node=walker.currentNode;if(translations[node.textContent.trim()])originalNodes.push([node,node.textContent,node.textContent.trim()])}window.siteText=(de,en,fr)=>({de,en,fr})[activeLanguage];function refreshGalleryStatus(){const count=[...document.querySelectorAll('.gallery-card')].filter(c=>!c.hidden).length;document.getElementById('gallery-status').textContent=count+' '+siteText('Bilder · Wische, scrolle oder nutze die Pfeile.','photos · Swipe, scroll or use the arrows.','photos · Balayez, faites défiler ou utilisez les flèches.')}function setLanguage(lang){activeLanguage=lang;document.documentElement.lang=lang==='de'?'de-CH':lang;languageSelect.value=lang;for(const [node,original,key] of originalNodes)node.textContent=lang==='de'?original:original.replace(key,translations[key][lang]);document.title=siteText('Lila Luchs Café | Kaffee & Familienzeit in Zofingen','Lila Luchs Café | Coffee & family time in Zofingen','Lila Luchs Café | Café et moments en famille à Zofingen');document.querySelector('textarea[name=message]').placeholder=siteText('Was möchtest du uns mitteilen?','What would you like to tell us?','Que souhaitez-vous nous dire ?');document.querySelector('.form-status').textContent='';refreshGalleryStatus();try{localStorage.setItem('lila-language',lang)}catch(e){}}languageSelect.addEventListener('change',()=>setLanguage(languageSelect.value));document.querySelectorAll('.gallery-tab').forEach(b=>b.addEventListener('click',refreshGalleryStatus));let saved='de';try{saved=localStorage.getItem('lila-language')||'de'}catch(e){}setLanguage(['de','en','fr'].includes(saved)?saved:'de');
