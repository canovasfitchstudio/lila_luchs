const contactDialog=document.querySelector('.contact-dialog');let enquiryType='general';document.querySelectorAll('[data-open-contact]').forEach(b=>b.addEventListener('click',()=>{enquiryType=b.hasAttribute('data-reservation')?'reservation':'general';contactDialog.showModal()}));contactDialog.querySelector('.close-contact').addEventListener('click',()=>contactDialog.close());contactDialog.addEventListener('click',e=>{if(e.target===contactDialog){const r=contactDialog.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)contactDialog.close()}});document.querySelector('#contact-form').addEventListener('submit',e=>{e.preventDefault();const form=e.currentTarget;if(!form.reportValidity())return;const d=new FormData(form);const body=siteText('Vorname','First name','Prénom')+': '+d.get('firstName')+'\n'+siteText('Nachname','Last name','Nom')+': '+d.get('lastName')+'\nEmail: '+d.get('email')+'\n\n'+siteText('Nachricht','Message','Message')+':\n'+d.get('message');const subject=enquiryType==='reservation'?siteText('Tischanfrage – Lila Luchs','Table request – Lila Luchs','Demande de table – Lila Luchs'):siteText('Anfrage – Lila Luchs','Enquiry – Lila Luchs','Demande – Lila Luchs');window.location.href='mailto:info@lila-luchs.ch?subject='+encodeURIComponent(subject)+'&body='+encodeURIComponent(body);contactDialog.querySelector('.form-status').textContent=siteText('Bitte sende die vorbereitete Nachricht in deiner E-Mail-App. Falls sie sich nicht öffnet, schreibe direkt an info@lila-luchs.ch.','Please send the prepared message in your email app. If it does not open, write directly to info@lila-luchs.ch.','Envoyez le message préparé dans votre application e-mail. Si elle ne s’ouvre pas, écrivez directement à info@lila-luchs.ch.');});
